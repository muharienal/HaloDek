APP_NAME=HaloDek
# PRODUKSI: APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., SESSION_SECURE_COOKIE=true
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
COMPANY_NAME="PT Petrokopindo Cipta Selaras"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=halodek
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@halodek.test"
MAIL_FROM_NAME="${APP_NAME}"

# Notifikasi WhatsApp via Fonnte (https://fonnte.com). WA_DRIVER: off | log | fonnte
# WA_TOKEN = token device dari dashboard Fonnte (menu Device > Token). Device harus berstatus "connect".
# WA_TO = nomor manager (628xxx, pisahkan koma bila lebih dari satu). Link memakai APP_URL.
WA_DRIVER=fonnte
WA_TOKEN=
WA_TO=
# Manajer (WA_TO): harian = ringkasan sekali sehari | setiap = tiap laporan baru | off
WA_MANAJER=harian
WA_RINGKASAN_JAM=16:00
# Prioritas laporan baru yang langsung dikirim ke WA Kepala Regu regunya
WA_KEPALA_PRIORITAS=tinggi,mendesak

# Aplikasi Inventaris Umum & IT (sumber data lokasi & barang). Token harus sama dengan INVENTARIS_API_TOKEN di .env Inventaris.
# Kosongkan INVENTARIS_URL bila Inventaris belum dipasang: form laporan tetap jalan tanpa pilihan lokasi/barang.
INVENTARIS_URL=http://localhost:8082
INVENTARIS_API_TOKEN=
