APP_NAME=HaloDek
# PRODUKSI: APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., SESSION_SECURE_COOKIE=true
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
COMPANY_NAME="PT Petrokopindo Cipta Selaras"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=halodek
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@halodek.test"
MAIL_FROM_NAME="${APP_NAME}"

# Notifikasi WhatsApp laporan baru (opsional). WA_DRIVER: off | log | fonnte | wablas
# WA_TO = nomor manager (628xxx, pisahkan koma bila lebih dari satu). Link memakai APP_URL.
WA_DRIVER=off
WA_TO=
WA_TOKEN=
WA_SECRET=
WABLAS_URL=https://pati.wablas.com
